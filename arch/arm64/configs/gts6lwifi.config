# CONFIG_CLK_GLYMUR_CAMCC is not set
# CONFIG_CLK_GLYMUR_DISPCC is not set
# CONFIG_CLK_GLYMUR_EVACC is not set
# CONFIG_CLK_GLYMUR_GCC is not set
# CONFIG_CLK_GLYMUR_TCSRCC is not set
# CONFIG_CLK_GLYMUR_VIDEOCC is not set
