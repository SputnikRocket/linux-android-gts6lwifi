# Samsung Galaxy Tab S6 Wi-Fi (SM-T860, gts6lwifi) on top of gki_defconfig:
#
#   make gki_defconfig gts6lwifi.config
#
# The device boots a boot.img (header v1) with an empty ramdisk and mounts
# system as root, so everything needed to get that far (and the main
# on-board peripherals) is built in rather than shipped as modules.

CONFIG_LOCALVERSION="-gts6lwifi"

# GKI builds binder and ashmem in Rust, which needs Kleaf's Rust toolchain.
# Plain make builds use the C implementations instead, so the result does
# not depend on what happens to be installed on the build machine.
# CONFIG_RUST is not set
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# Firmware calls, pinctrl, clocks
CONFIG_QCOM_SCM=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM8150=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_8150=y
CONFIG_SM_GPUCC_8150=y
CONFIG_QCOM_CLK_RPMH=y
# SM8150 display clock controller (dispcc-sm8250.c covers SM8150 too)
CONFIG_SM_DISPCC_8250=y

# RPMh, power domains, regulators, interconnects, IOMMU
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_PDC=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8150=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_LLCC=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_LMH=y

# IPC with the always-on processor and the remote subsystems
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SOCINFO=y
CONFIG_RESET_QCOM_AOSS=y
CONFIG_RESET_QCOM_PDC=y
CONFIG_NVMEM_QCOM_QFPROM=y

# Watchdog: keep it fed if the bootloader left it running
CONFIG_QCOM_WDT=y

# PMICs (PM8150 / PM8150B / PM8150L over SPMI)
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_TSENS=y

# QUP serial engines: debug UART, I2C, SPI
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y

# Storage: UFS (system) and microSD
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_MMC_SDHCI_MSM=y

# Touchscreen
CONFIG_TOUCHSCREEN_STM_FTS1BA90A=y

# USB (device mode)
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_ROLE_SWITCH=y
# The SM5705 MUIC switches D+/D-: no USB data without it
CONFIG_EXTCON_SM5705=y

# Display: the AMSA05RB06 panel on the MSM display driver, with the
# bootloader's splash framebuffer until it takes over, and a kernel console
CONFIG_DRM_PANEL_SAMSUNG_AMSA05RB06=y
# Reference voltage for the DSI PHYs (refgen-supply of the DSI hosts)
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# A console font that is readable at 2560x1600 (fbcon=font:TER16x32)
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Display engine (DPU/DSI) and GPU (Adreno 640)
CONFIG_DRM_MSM=y
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_HDMI is not set
# CONFIG_DRM_MSM_DSI_28NM_PHY is not set
# CONFIG_DRM_MSM_DSI_20NM_PHY is not set
# CONFIG_DRM_MSM_DSI_28NM_8960_PHY is not set
# CONFIG_DRM_MSM_DSI_14NM_PHY is not set
# CONFIG_DRM_MSM_DSI_10NM_PHY is not set

# Remote processors (ADSP, CDSP, SLPI, modem)
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_FASTRPC=y

# WCN3998 Wi-Fi and Bluetooth
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y

# android-mainline's gki_defconfig enables lockdep, which slows the whole
# kernel down; it is not for a device kernel
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set

# Keep the kernel log in Samsung's RAM log buffer, for /proc/last_kmsg in
# TWRP or stock after a failed boot (see drivers/misc/gts6lwifi-diag.c)
CONFIG_GTS6LWIFI_DIAG=y

# Other SoCs' clock controller and pinctrl drivers are enabled by
# default with ARCH_QCOM; leave them out of this kernel.
# CONFIG_CLK_ELIZA_DISPCC is not set
# CONFIG_CLK_ELIZA_GCC is not set
# CONFIG_CLK_ELIZA_TCSRCC is not set
